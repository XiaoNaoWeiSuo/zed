[Desktop Entry]
Version=1.0
Type=Application
Name=$APP_NAME
GenericName=Text Editor
Comment=A fast local code editor with an agent harness.
TryExec=$APP_CLI
StartupNotify=$DO_STARTUP_NOTIFY
Exec=$APP_CLI $APP_ARGS
Icon=$APP_ICON
Categories=Utility;TextEditor;Development;IDE;
Keywords=lin;editor;code;
# To add Lin to "Open Folder With..." context menu, add `inode/directory` to the MimeType field (semicolon separated).
MimeType=text/plain;application/x-zerosize;x-scheme-handler/lin;
Actions=NewWorkspace;

[Desktop Action NewWorkspace]
Exec=$APP_CLI --new $APP_ARGS
Name=Open a new workspace
